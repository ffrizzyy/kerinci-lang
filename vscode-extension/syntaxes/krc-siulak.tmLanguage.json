{
  "name": "KerinciLang (Siulak (legacy 0.5))",
  "patterns": [
    {
      "match": "#.*$",
      "name": "comment.line.number-sign.krc"
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.krc",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.krc"
        }
      ]
    },
    {
      "match": "\\b\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.krc"
    },
    {
      "match": "\\b(alem|ambik|balik|cubo|habih|kalu|lain|lanjut|mulai|ngangkat|pilih|putuh|selamo|tangkap|untuk)\\b",
      "name": "keyword.control.krc"
    },
    {
      "match": "\\b(barang|guno|tetap)\\b",
      "name": "storage.type.krc"
    },
    {
      "match": "\\b(apo|dak_samo|idak|kurang_daripado|kurang_samo|lebih_daripado|lebih_samo|ngan|samo)\\b",
      "name": "keyword.operator.word.krc"
    },
    {
      "match": "\\b(nyetak|tanyo)\\b",
      "name": "support.function.krc"
    },
    {
      "match": "\\b(betul|kosong|salah)\\b",
      "name": "constant.language.krc"
    },
    {
      "match": "\\b(baco|bagi|bilangan|bukak|daftar|disatu|hapus|isi|jarak|kali|kato|kurang|mecem|milih|nambahkah|nantik|panjang|pecahan|peta|pisah|pulang|tambah|tulis|tutup)(?=\\()\\b",
      "name": "support.function.builtin.krc"
    }
  ],
  "scopeName": "source.krc.siulak"
}
