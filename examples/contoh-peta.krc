# contoh-peta.krc: peta, pilih, dan mengubah tipe

barang siswa = {"Budi": 80, "Sari": 92, "Dewi": 65}

guno huruf(nilai) {
    barang kelas = bilangan(bagi(nilai, 10))
    pilih kelas {
        kalu 10, 9 { balik "A" }
        kalu 8 { balik "B" }
        kalu 7 { balik "C" }
        lain { balik "D" }
    }
}

siswa["Rudi"] = 58
untuk nama alem siswa {
    nyetak nama + ": " + siswa[nama] + " (" + huruf(siswa[nama]) + ")"
}
nyetak "Jumlah siswa: " + panjang(siswa)

kalu isi(siswa, "Sari") { nyetak "Sari ada" }
kalu idak isi(siswa, "Andi") { nyetak "Andi tidak ada" }

# mengubah tipe
barang teks = "42"
nyetak mecem(teks)
barang angka = bilangan(teks)
nyetak mecem(angka)
nyetak angka + 8
nyetak pecahan("2.5") * 2

# pilih dengan beberapa nilai
barang hari = "minggu"
pilih hari {
    kalu "sabtu", "minggu" { nyetak "libur" }
    lain { nyetak "kerja" }
}

# peta di dalam peta, daftar di dalam peta
barang murid = {"nama": "Budi", "nilai": [80, 90], "alamat": {"kota": "Sungai Penuh"}}
nambahkah(murid["nilai"], 100)
nyetak murid
nyetak murid["alamat"]["kota"]
